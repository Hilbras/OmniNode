{
  "name": "@hilbras/omninode",
  "version": "2.0.0",
  "description": "Provider-agnostic multi-AI orchestration platform: coordinates CLI agents, AI providers, memory, roles, reports and planning into one execution system.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "omninode": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets/logo.svg",
    "assets/favicon.svg"
  ],
  "prepublishOnly": "npm run build && npm test",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilbras/OmniNode.git"
  },
  "bugs": {
    "url": "https://github.com/Hilbras/OmniNode/issues"
  },
  "homepage": "https://github.com/Hilbras/OmniNode#readme",
  "keywords": [
    "ai",
    "orchestration",
    "multi-agent",
    "cli-agents",
    "llm",
    "pipeline",
    "provider-agnostic",
    "agent-protocol",
    "multi-ai",
    "reliability"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "cli": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run build && npm test",
    "validate:package": "node scripts/release-gates.mjs package",
    "scan:secrets": "node scripts/release-gates.mjs secrets",
    "check:release": "node scripts/release-gates.mjs version",
    "gates": "node scripts/release-gates.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/node": "^22.7.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
